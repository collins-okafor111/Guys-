# RESEND_API_KEY: Your API Key from https://resend.com/api-keys
# Server-side variable used to send real email verifications and password reset codes.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender email address.
# Defaults to "Shopza <onboarding@resend.dev>" when no custom domain is registered.
# Note: onboarding@resend.dev only allows sending to the email of the Resend account owner.
# To send to any customer email address, add & verify your custom domain in Resend.
RESEND_FROM_EMAIL="Shopza <onboarding@resend.dev>"

# VITE_CONVEX_URL: The deployment URL for Convex backend (e.g., https://happy-otter-123.convex.cloud)
# Run `npx convex dev` to obtain your dev deployment URL.
VITE_CONVEX_URL=""

# VITE_GOOGLE_CLIENT_ID: Your Google OAuth 2.0 Web Client ID from Google Cloud Console.
# Required for genuine Google Sign-In with account selection and ID token verification.
# Create at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client IDs -> Web application)
# Authorized JavaScript origins: Add your app's origin URL (e.g. https://your-domain.app or http://localhost:3000)
VITE_GOOGLE_CLIENT_ID=""

# SESSION_SECRET: Secret key for signing production HMAC session tokens.
# A cryptographically random key is generated automatically if omitted.
SESSION_SECRET=""

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


